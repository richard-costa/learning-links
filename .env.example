POSTGRES_PASSWORD=replace-with-a-long-random-password
LEARNING_LINKS_POSTGRES_PORT=5433

# Used when running the API or pytest on the host machine.
DATABASE_URL=postgresql://learning_links:replace-with-a-long-random-password@127.0.0.1:5433/learning_links
TEST_DATABASE_URL=postgresql://learning_links:replace-with-a-long-random-password@127.0.0.1:5433/learning_links_test

# Optional local-only authentication bypass. Leave empty for normal authentication.
LEARNING_LINKS_DISABLE_AUTH=
# When auth is disabled and multiple active users exist, choose the workspace owner explicitly.
LEARNING_LINKS_DEV_USER=

# Optional CLI workspace owner. Required for workspace commands when multiple users exist.
LEARNING_LINKS_USER=

# One-time migration aid for a pre-multi-user database with an existing shared workspace.
# Leave empty when there is exactly one active user; set to an existing user email if ownership is ambiguous.
LEARNING_LINKS_MIGRATION_USER=

# Optional. Only needed when starting the Compose `public` profile.
CLOUDFLARE_TUNNEL_TOKEN=
