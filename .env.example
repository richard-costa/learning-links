POSTGRES_PASSWORD=replace-with-a-long-random-password
LEARNING_LINKS_POSTGRES_PORT=5433

# Used when running the API or pytest on the host machine.
DATABASE_URL=postgresql://learning_links:replace-with-a-long-random-password@127.0.0.1:5433/learning_links
TEST_DATABASE_URL=postgresql://learning_links:replace-with-a-long-random-password@127.0.0.1:5433/learning_links_test

# Optional local-only authentication bypass. Leave empty for normal authentication.
LEARNING_LINKS_DISABLE_AUTH=
# When auth is disabled and multiple active users exist, choose the workspace owner explicitly.
LEARNING_LINKS_DEV_USER=

# Optional CLI workspace owner. Required for workspace commands when multiple users exist.
LEARNING_LINKS_USER=

# One-time migration aid for a pre-multi-user database with an existing shared workspace.
# Leave empty when there is exactly one active user; set to an existing user email if ownership is ambiguous.
LEARNING_LINKS_MIGRATION_USER=

# Session cookies auto-detect HTTPS from the request/X-Forwarded-Proto.
# Set to 1 behind Tailscale Funnel if your proxy setup does not forward HTTPS correctly.
LEARNING_LINKS_SECURE_COOKIES=
LEARNING_LINKS_SESSION_DAYS=7
LEARNING_LINKS_MAX_SESSIONS_PER_USER=10

# Public signup is intentionally disabled by default. Set to 1 only when you want
# visitors to be able to create accounts.
LEARNING_LINKS_ENABLE_SIGNUP=
LEARNING_LINKS_MAX_USERS=50

# Public auth throttling. These defaults are intentionally conservative for a
# small self-hosted instance.
LEARNING_LINKS_LOGIN_ATTEMPTS=10
LEARNING_LINKS_LOGIN_CLIENT_ATTEMPTS=50
LEARNING_LINKS_LOGIN_WINDOW_SECONDS=900
LEARNING_LINKS_SIGNUP_ATTEMPTS_PER_HOUR=6
LEARNING_LINKS_SIGNUP_GLOBAL_PER_HOUR=30

# Request/workspace safety limits.
LEARNING_LINKS_MAX_REQUEST_BYTES=1000000
LEARNING_LINKS_MAX_TOPICS=5000
LEARNING_LINKS_MAX_ENCOUNTERS=25000

# Optional. Only needed when starting the Compose `public` profile.
CLOUDFLARE_TUNNEL_TOKEN=
